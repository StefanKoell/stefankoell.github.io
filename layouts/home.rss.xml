{{- $pages := where site.RegularPages "Type" "post" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title | transform.XMLEscape }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>Recent posts on {{ site.Title | transform.XMLEscape }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.Locale | default site.Language.Name }}</language>
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range first 50 $pages }}
    <item>
      <title>{{ .Title | transform.XMLEscape }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | plainify | transform.XMLEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
